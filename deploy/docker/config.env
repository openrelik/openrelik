# OpenRelik versions to run: `latest` (built from the main branch) or a release
# minor such as 0.18, which follows the newest 0.18.x release of each image.
# Using latest means that you are running the bleeding edge version and we
# cannot guarantee that it will not be broken.

# Platform version: server, mediator, metrics and the web UI. The server and
# the UI have their own patch releases (server 0.18.1, UI 0.18.3); to pin one,
# set OPENRELIK_SERVER_VERSION (server, mediator, metrics) or
# OPENRELIK_UI_VERSION to its full version.
OPENRELIK_VERSION=latest

# Worker versions
OPENRELIK_WORKER_STRINGS_VERSION=latest
OPENRELIK_WORKER_GREP_VERSION=latest
OPENRELIK_WORKER_PLASO_VERSION=latest
OPENRELIK_WORKER_EXTRACTION_VERSION=latest
OPENRELIK_WORKER_ANALYZER_CONFIG_VERSION=latest

# Change these
OPENRELIK_SERVER_URL=http://localhost:8710
OPENRELIK_API_VERSION=v1

# PostgreSQL PATH local DB
POSTGRES_DATA_PATH=./data/postgresql

# PostgreSQL database name.
POSTGRES_DB=<REPLACE_WITH_POSTGRES_DATABASE_NAME>

# PostgreSQL database user.
POSTGRES_USER=<REPLACE_WITH_POSTGRES_USER>

# PostgreSQL password for the database user. Tip: Generate one with (on linux):
# $ < /dev/urandom tr -dc A-Za-z0-9 | head -c 32 ; echo
POSTGRES_PASSWORD=<REPLACE_WITH_POSTGRES_PASSWORD>
