# Local settings for compose.yml, one .env per checkout. Generated by ./devctl init
# (and ./devctl worktree create for worktrees). Do not commit .env.

# Compose project of this checkout: "openrelik-main" for the main checkout,
# "openrelik-<name>" for worktrees. Each project has its own database and ports,
# so multiple worktree stacks can run simultaneously.
COMPOSE_PROJECT_NAME=openrelik-main

# Host ports for this checkout's stack (worktrees get 3001/3051/8711/7071, etc.).
UI_PORT=3000
RUNESTONE_PORT=3050
API_PORT=8710
MCP_PORT=7070

# Generated by ./devctl init.
POSTGRES_PASSWORD=

# The development user (an admin) created in the database.
OPENRELIK_DEV_USER=dev
OPENRELIK_DEV_PASSWORD=dev

# Optional: Gemini API key for the server's LLM features.
GOOGLEAI_API_KEY=

# Optional: API key for the MCP server (profile "mcp").
OPENRELIK_API_KEY=

# Optional: enable profiles without passing --profile, e.g. "plaso,grep".
# COMPOSE_PROFILES=
